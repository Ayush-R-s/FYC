HELP.md
target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ========================
# LOCAL / SECRET CONFIG  ← NEVER COMMIT THESE
# ========================
src/main/resources/application-local.properties
src/main/resources/application-dev.properties
src/main/resources/application-test.properties
*.env
.env

# ========================
# CREDENTIALS & EXPORTS
# ========================
# Excel files exported by the app (contain plain-text passwords)
*.xlsx
*.xls
*.csv
student-credentials*.xlsx

# ========================
# IDE: Spring Tool Suite
# ========================
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# ========================
# IDE: IntelliJ IDEA
# ========================
.idea/
*.iws
*.iml
*.ipr

# ========================
# IDE: NetBeans
# ========================
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ========================
# IDE: VS Code
# ========================
# Ignore all VS Code settings except shared extensions list
.vscode/*
!.vscode/extensions.json
# But DO commit launch.json so teammates get the local profile config
!.vscode/launch.json

# ========================
# LOGS & TEMP
# ========================
*.log
logs/
tmp/
temp/
